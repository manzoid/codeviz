{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "codeviz: serve current file",
      "type": "shell",
      "command": "pkill -f 'codeviz.*--serve' >/dev/null 2>&1 || true; sleep 0.3; exec codeviz '${file}' --serve --port 8930",
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    }
  ]
}
